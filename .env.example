# ─────────────────────────────────────────────────────────────────────────────
# lzacademy · sitio de marketing (Next.js, en Vercel)
#
# Copia este archivo a `.env.local` para desarrollo, y pon las mismas claves en
# Vercel → Settings → Environment Variables para producción.
#
# Sin `/api` al final ni barra final: el código compone las rutas.
NEXT_PUBLIC_BACKEND_URL=http://localhost:3200

# ================================
# SUPABASE (el panel de /admin)

NEXT_PUBLIC_SUPABASE_URL=https://<proyecto>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ================================
# PLATAFORMA (a dónde se manda a comprar lo que este sitio no cobra)
# ================================
# Un plan abierto en el admin de la plataforma que este backend todavía no sabe
# cobrar se ANUNCIA aquí y su botón manda allí (`/pricing?plan=<clave>`).
# OPCIONAL: sin ella cae a https://app.lainz590.com.
NEXT_PUBLIC_PLATFORM_URL=http://localhost:3000

NEXT_PUBLIC_CALENDLY_INFO_URL=

NEXT_PUBLIC_CALENDLY_SPEAKING_URL=
